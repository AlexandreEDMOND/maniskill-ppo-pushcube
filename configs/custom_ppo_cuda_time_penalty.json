{
  "name": "custom-ppo-cuda-time-penalty",
  "environment": {
    "id": "PushCube-v1",
    "robot": "panda",
    "observation_mode": "state",
    "control_mode": "pd_joint_delta_pos",
    "reward_mode": "normalized_dense",
    "simulation_backend": "physx_cuda"
  },
  "reward": {
    "time_penalty_per_step": 0.01
  },
  "training": {
    "seed": 9351,
    "total_timesteps": 3000000,
    "num_envs": 4096,
    "rollout_steps": 4,
    "update_epochs": 4,
    "minibatch_size": 512,
    "learning_rate": 0.0003,
    "anneal_learning_rate": true,
    "gamma": 0.8,
    "gae_lambda": 0.9,
    "clip_coefficient": 0.2,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.005,
    "max_grad_norm": 0.5,
    "target_kl": 0.1,
    "checkpoint_interval_steps": 500000,
    "hidden_size": 256,
    "hidden_layers": 3,
    "initial_logstd": 0.0
  },
  "evaluation": {
    "simulation_backend": "physx_cpu",
    "seeds": [
      10000, 10001, 10002, 10003, 10004,
      10005, 10006, 10007, 10008, 10009,
      10010, 10011, 10012, 10013, 10014,
      10015, 10016, 10017, 10018, 10019
    ]
  }
}
